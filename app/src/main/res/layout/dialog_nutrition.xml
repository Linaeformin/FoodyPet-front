<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="28dp"
    android:layout_marginEnd="28dp"
    android:background="@drawable/bg_nutrition_dialog"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/nutritionTitleTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_medium"
        android:gravity="center"
        android:text="영양성분표"
        android:textColor="@color/black"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/nutritionImageIv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:adjustViewBounds="true"
        android:background="@drawable/bg_nutrition_image_border"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/image_nutri" />

</LinearLayout>