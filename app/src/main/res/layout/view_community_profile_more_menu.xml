<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_diary_more_menu">

    <LinearLayout
        android:id="@+id/menu_block_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/menu_block_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="차단한 사용자"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/scdream_regular" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9D9D9" />

    <LinearLayout
        android:id="@+id/menu_alarm_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/menu_alarm_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알림"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/scdream_regular" />
    </LinearLayout>

</LinearLayout>