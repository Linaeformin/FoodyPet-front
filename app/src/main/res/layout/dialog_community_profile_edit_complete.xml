<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="95dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_edit_complete_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_radius_24"
        android:paddingStart="32dp"
        android:paddingTop="72dp"
        android:paddingEnd="32dp"
        android:paddingBottom="42dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/dialog_profile_nickname_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/scdream_medium"
            android:text="냠냠이먹자"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/dialog_profile_edit_iv"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/dialog_profile_edit_iv"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/icon_edit_orange"
            app:layout_constraintBottom_toBottomOf="@id/dialog_profile_nickname_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dialog_profile_nickname_tv"
            app:layout_constraintTop_toTopOf="@id/dialog_profile_nickname_tv" />

        <TextView
            android:id="@+id/community_search_profile_pet_type_tv"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:fontFamily="@font/scdream_light"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="고양이"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_profile_nickname_tv" />

        <TextView
            android:id="@+id/dialog_profile_description_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/scdream_light"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="7dp"
            android:text="고양이 ‘랑이’와 함께 밥 먹는 계정입니다! 스트릿 출신, 그루밍잘하고 정말 동글동글한 동그’랑이’랑 함께하실 분!"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/community_search_profile_pet_type_tv" />

        <TextView
            android:id="@+id/dialog_profile_complete_btn"
            android:layout_width="200dp"
            android:layout_height="40dp"
            android:layout_marginTop="52dp"
            android:background="@drawable/bg_orange_fill_16"
            android:elevation="4dp"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="수정 완료"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_profile_description_tv" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/dialog_profile_image_iv"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/circle_border"
        android:clipToOutline="true"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/cat_1"
        app:layout_constraintBottom_toTopOf="@id/profile_edit_complete_dialog"
        app:layout_constraintEnd_toEndOf="@id/profile_edit_complete_dialog"
        app:layout_constraintStart_toStartOf="@id/profile_edit_complete_dialog"
        app:layout_constraintTop_toTopOf="@id/profile_edit_complete_dialog" />

</androidx.constraintlayout.widget.ConstraintLayout>