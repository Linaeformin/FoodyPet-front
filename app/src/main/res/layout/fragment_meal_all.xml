<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp">

        <!-- 상단 헤더 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/meal_back_iv"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/meal_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_medium"
                android:text="전체 식단"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- 이름 / 날짜 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meal_owner_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/scdream_medium"
                android:text="랑이의 식단"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meal_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_gravity="bottom"
                android:fontFamily="@font/scdream_light"
                android:text="2026.03.30"
                android:textColor="@color/dark_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 탭 고정 -->
        <LinearLayout
            android:id="@+id/meal_tab_container_ll"
            android:layout_width="194dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meal_unfed_tab_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_meal_tab_selected"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="미급여"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meal_fed_tab_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_meal_tab_unselected"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="급여"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 리스트만 스크롤 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/meal_list_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:scrollbars="none" />

    <!-- 하단 버튼 고정 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/meal_edit_tv"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_bottom_filled_button"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="식단 수정하기"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_gravity="top"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_bottom_button_shadow" />

            <TextView
                android:id="@+id/meal_recommend_tv"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/bg_bottom_outline_button"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="이후 식단 추천 받기"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>