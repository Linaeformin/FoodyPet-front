<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/meal_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/meal_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="밥 일기 등록"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/meal_more_iv"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:visibility="visible"
                android:contentDescription="더보기"
                android:src="@drawable/btn_menu" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 본문 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 이름 / 날짜 / 오른쪽 아이콘 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/meal_info_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/meal_owner_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/scdream_medium"
                        android:text="랑이의 식단"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/meal_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/scdream_light"
                        android:text="2026.03.30"
                        android:textColor="@color/dark_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/put_food_iv"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="음식 추가"
                    android:src="@drawable/btn_put_food" />
            </RelativeLayout>

            <!-- 식단 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/meal_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/light_orange"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/image_upload_area"
                        android:layout_width="match_parent"
                        android:layout_height="250dp">

                        <!-- 선택된 이미지 미리보기 -->
                        <ImageView
                            android:id="@+id/meal_preview_iv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            android:scaleType="centerCrop"
                            android:contentDescription="식단 사진 미리보기" />

                        <!-- 기본 업로드 안내 영역 -->
                        <LinearLayout
                            android:id="@+id/image_placeholder_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/meal_image_add_iv"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="28dp"
                                android:contentDescription="식단 사진 추가"
                                android:src="@drawable/icon_image" />

                            <TextView
                                android:id="@+id/meal_image_guide_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/scdream_light"
                                android:text="식단 사진을 첨부해주세요."
                                android:textColor="@color/dark_gray"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- 시각 칩을 이미지 위에 겹치기 -->
                        <TextView
                            android:id="@+id/page_title_chip_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_orange_fill_10"
                            android:fontFamily="@font/scdream_medium"
                            android:gravity="center"
                            android:minWidth="78dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="13:00"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/light_orange" />

                    <!-- 음식 목록 -->
                    <TextView
                        android:id="@+id/meal_food_list_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="8dp"
                        android:fontFamily="@font/scdream_light"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="흑돼지 치즈볼 1개, 닭오돌뼈 10g,\n플라그오프, 어거스틴 슈퍼부스트,\n뉴로액트, 도란도란 단호박"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 오늘의 기록 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_medium"
                    android:text="오늘의 기록"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@color/light_orange" />
            </LinearLayout>

            <!-- 선호도 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="선호도"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/preference_1_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/icon_like" />

                    <ImageView
                        android:id="@+id/preference_2_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/icon_like" />

                    <ImageView
                        android:id="@+id/preference_3_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/icon_like" />

                    <ImageView
                        android:id="@+id/preference_4_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/icon_like" />

                    <ImageView
                        android:id="@+id/preference_5_iv"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/icon_unlike" />
                </LinearLayout>
            </LinearLayout>

            <!-- 섭취 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="섭취 상태"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        android:id="@+id/tv_eat_all"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_fill_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="다 먹음"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_eat_some"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_stroke_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="조금 남김"
                        android:textColor="@color/light_orange"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_eat_none"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_stroke_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="안 먹음"
                        android:textColor="@color/light_orange"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 이상 여부 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="이상 여부"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <TextView
                        android:id="@+id/tv_symptom_itch"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_stroke_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="가려움"
                        android:textColor="@color/light_orange"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_symptom_diarrhea"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_fill_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="설사"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_symptom_tired"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_stroke_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="무기력"
                        android:textColor="@color/light_orange"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_symptom_vomit"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_orange_fill_20"
                        android:fontFamily="@font/scdream_regular"
                        android:gravity="center"
                        android:text="구토"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 음수량 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="음수량"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/water_amount_et"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_input_underline"
                    android:gravity="center"
                    android:inputType="number"
                    android:paddingBottom="2dp"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ml"
                    android:textColor="@color/black"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 영양제 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="영양제"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/supplement_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    app:columnCount="2"
                    app:orientation="horizontal" />
            </LinearLayout>

            <!-- 메모 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="top"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/scdream_regular"
                    android:text="메모"
                    android:textColor="@color/black"
                    android:textSize="15dp" />

                <EditText
                    android:id="@+id/memo_et"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:fontFamily="@font/scdream_light"
                    android:gravity="top|start"
                    android:hint="메모를 입력하세요."
                    android:inputType="textMultiLine"
                    android:minHeight="12dp"
                    android:scrollHorizontally="false"
                    android:textColor="@color/black"
                    android:textColorHint="@color/dark_gray"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 하단 구분선 + 등록 버튼을 스크롤 내부로 이동 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:background="@color/light_orange" />

            <TextView
                android:id="@+id/meal_register_btn"
                android:layout_width="280dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orange_fill_16"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="등록하기"
                android:textColor="@color/black"
                android:textSize="18sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>