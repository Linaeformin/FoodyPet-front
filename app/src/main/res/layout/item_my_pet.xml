<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_pet_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_orange_stroke_20"
    android:paddingStart="32dp"
    android:paddingTop="44dp"
    android:paddingEnd="32dp"
    android:paddingBottom="38dp">

    <!-- 반려동물 이미지 -->
    <FrameLayout
        android:id="@+id/my_pet_profile_img_area"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/circle_border"
        android:padding="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/my_pet_profile_img_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/cat_1" />

    </FrameLayout>

    <!-- 이름 -->
    <TextView
        android:id="@+id/my_pet_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:fontFamily="@font/scdream_medium"
        android:text="랑이"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/my_pet_profile_img_area"
        app:layout_constraintTop_toTopOf="@id/my_pet_profile_img_area"
        app:layout_constraintBottom_toTopOf="@id/my_pet_category_row"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- 생년월일 -->
    <TextView
        android:id="@+id/my_pet_birth_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/scdream_light"
        android:text="2022.04.07 생"
        android:textColor="@color/light_gray"
        android:textSize="15sp"
        app:layout_constraintBaseline_toBaselineOf="@id/my_pet_name_tv"
        app:layout_constraintStart_toEndOf="@id/my_pet_name_tv" />

    <!-- 카테고리 줄 -->
    <LinearLayout
        android:id="@+id/my_pet_category_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@id/my_pet_name_tv"
        app:layout_constraintTop_toBottomOf="@id/my_pet_name_tv">

        <TextView
            android:id="@+id/my_pet_type_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_stock_category"
            android:fontFamily="@font/scdream_light"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="고양이"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/my_pet_breed_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_stock_category"
            android:fontFamily="@font/scdream_light"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="칼리코"
            android:textColor="@color/black"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 중성화 / 성별 -->
    <LinearLayout
        android:id="@+id/my_pet_neutered_row"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_stock_category"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        app:layout_constraintStart_toStartOf="@id/my_pet_category_row"
        app:layout_constraintTop_toBottomOf="@id/my_pet_category_row">

        <TextView
            android:id="@+id/my_pet_neutered_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fontFamily="@font/scdream_light"
            android:gravity="center"
            android:text="중성화 완료"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/my_pet_gender_iv"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="8dp"
            android:contentDescription="성별"
            android:src="@drawable/icon_girl" />

    </LinearLayout>

    <!-- 삭제 아이콘 -->
    <ImageView
        android:id="@+id/my_pet_delete_iv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="삭제"
        android:padding="2dp"
        android:src="@drawable/icon_trash_orange"
        app:layout_constraintBottom_toBottomOf="@id/my_pet_profile_img_area"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 구분선 -->
    <View
        android:id="@+id/my_pet_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/regular_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/my_pet_profile_img_area" />

    <!-- 급여 횟수 라벨 -->
    <TextView
        android:id="@+id/my_pet_feed_count_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/scdream_light"
        android:text="급여 횟수"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/my_pet_divider" />

    <TextView
        android:id="@+id/my_pet_feed_count_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:text="3회"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/my_pet_feed_count_label_tv"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 급여 시각 -->
    <TextView
        android:id="@+id/my_pet_feed_time_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/scdream_light"
        android:text="급여 시각"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/my_pet_feed_count_label_tv" />

    <TextView
        android:id="@+id/my_pet_feed_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:text="7:00, 13:00, 20:00"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/my_pet_feed_time_label_tv"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 영양제 -->
    <TextView
        android:id="@+id/my_pet_supplement_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/scdream_light"
        android:text="영양제"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/my_pet_feed_time_label_tv" />

    <TextView
        android:id="@+id/my_pet_supplement_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:text="유산균 1정, 오메가3 2정"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBaseline_toBaselineOf="@id/my_pet_supplement_label_tv"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 프로필 수정 버튼 -->
    <TextView
        android:id="@+id/my_pet_edit_btn"
        android:layout_width="210dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_orange_fill_16"
        android:fontFamily="@font/scdream_medium"
        android:gravity="center"
        android:text="프로필 수정"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@id/my_pet_supplement_label_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>