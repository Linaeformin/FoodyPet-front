<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_diary_more_menu">

    <LinearLayout
        android:id="@+id/menu_first_layout"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/menu_first_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="댓글 신고하기"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/scdream_regular" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9D9D9" />

    <LinearLayout
        android:id="@+id/menu_second_layout"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/menu_second_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="사용자 차단하기"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/scdream_regular" />

    </LinearLayout>

</LinearLayout>