<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recent_search_item_layout"
    android:layout_width="wrap_content"
    android:layout_height="35dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_gray_stroke_16"
    android:paddingStart="20dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/recent_search_item_keyword_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:text="고양이 식단"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/recent_search_item_delete_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/recent_search_item_delete_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"
        android:contentDescription="검색어 삭제"
        android:src="@drawable/icon_x"
        app:layout_constraintBottom_toBottomOf="@id/recent_search_item_keyword_tv"
        app:layout_constraintStart_toEndOf="@id/recent_search_item_keyword_tv"
        app:layout_constraintTop_toTopOf="@id/recent_search_item_keyword_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>