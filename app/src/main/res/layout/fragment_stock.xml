<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 상단 헤더 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/stock_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/stock_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="재고 관리"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- 카테고리 버튼 영역 -->
        <LinearLayout
            android:id="@+id/stock_category_layout"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/category_cooked_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stock_fill_5"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="화식"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/category_wet_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stock_unfill_5"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="습식"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/category_fresh_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stock_unfill_5"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="생식"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/category_dry_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stock_unfill_5"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="건식"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/category_snack_tv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stock_unfill_5"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="간식"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 정렬 영역 -->
        <LinearLayout
            android:id="@+id/stock_sort_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/stock_sort_iv"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="정렬"
                android:src="@drawable/icon_sort" />

            <TextView
                android:id="@+id/stock_sort_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_regular"
                android:text="유통기한 순"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/stock_scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/stock_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/stock_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/stock_empty_tv"
                android:layout_width="match_parent"
                android:layout_height="410dp"
                android:background="@drawable/bg_orange_stroke_20"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="등록된 재고가 없어요."
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/expired_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:fontFamily="@font/scdream_medium"
                android:text="유통기한이 지난 음식"
                android:textColor="@color/black"
                android:textSize="17sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expired_stock_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/expired_empty_tv"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_orange_stroke_20"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="해당된 음식이 없어요."
                android:textColor="@color/black"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 플로팅 추가 버튼 -->
    <ImageButton
        android:id="@+id/stock_add_btn"
        android:layout_width="69dp"
        android:layout_height="69dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/bg_food_add_circle"
        android:contentDescription="음식 추가"
        android:elevation="10dp"
        android:outlineProvider="background"
        android:padding="0dp"
        android:scaleType="center"
        android:src="@drawable/ic_food_plus"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>