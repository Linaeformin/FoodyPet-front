<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingEnd="24dp">

    <!-- 상단 헤더 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/meal_back_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="뒤로가기"
            android:src="@drawable/btn_arrow_left" />

        <TextView
            android:id="@+id/meal_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/scdream_bold"
            android:text="식단 분석"
            android:textColor="@color/black"
            android:textSize="18sp" />
    </RelativeLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/meal_scroll_sv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/meal_analysis_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="랑이의 1회 식단 분석"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/scdream_medium"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/meal_chart_card_cv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="18dp"
                app:strokeColor="#F2A16A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/meal_pie_chart_pc"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp" />

                    <!-- 서버 데이터로 항목 추가할 영역 -->
                    <GridLayout
                        android:id="@+id/meal_nutrient_legend_gl"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alignmentMode="alignMargins"
                        android:columnCount="2"
                        android:rowCount="4"
                        android:useDefaultMargins="true"
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 칼로리 -->
            <LinearLayout
                android:id="@+id/meal_calorie_section_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/meal_calorie_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="칼로리"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:fontFamily="@font/scdream_medium"/>
                    
                    <TextView
                        android:id="@+id/meal_calorie_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="220kcal"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:fontFamily="@font/scdream_medium"/>


                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/meal_calorie_status_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/meal_calorie_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null"
                            app:tint="#57B600" />

                        <TextView
                            android:id="@+id/meal_calorie_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/meal_calorie_bar_fl"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_meal_bar_outline">

                    <View
                        android:id="@+id/meal_calorie_fill_v"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_meal_calorie_fill" />

                </FrameLayout>
            </LinearLayout>

            <!-- 단백질 -->
            <LinearLayout
                android:id="@+id/meal_protein_section_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/meal_protein_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="단백질"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <TextView
                        android:id="@+id/meal_protein_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="26%"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/meal_protein_status_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/meal_protein_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/meal_protein_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/meal_protein_bar_fl"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_meal_bar_outline">

                    <View
                        android:id="@+id/meal_protein_fill_v"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_meal_protein_fill" />

                </FrameLayout>
            </LinearLayout>

            <!-- 지방 -->
            <LinearLayout
                android:id="@+id/meal_fat_section_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/meal_fat_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지방"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <TextView
                        android:id="@+id/meal_fat_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="9%"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/meal_fat_status_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/meal_fat_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/meal_fat_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/meal_fat_bar_fl"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_meal_bar_outline">

                    <View
                        android:id="@+id/meal_fat_fill_v"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_meal_fat_fill" />

                </FrameLayout>
            </LinearLayout>

            <!-- 조회분 -->
            <LinearLayout
                android:id="@+id/meal_carbohydrate_section_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/meal_carbohydrate_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="조회분"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <TextView
                        android:id="@+id/meal_carbohydrate_value_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="8%"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:fontFamily="@font/scdream_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/meal_carbohydrate_status_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/meal_carbohydrate_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/meal_carbohydrate_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/meal_carbohydrate_bar_fl"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_meal_bar_outline">

                    <View
                        android:id="@+id/meal_carbohydrate_fill_v"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_meal_carbohydrate_fill" />

                </FrameLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/meal_more_card_cv"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:strokeColor="#F2A16A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/meal_more_toggle_ll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/meal_more_arrow_iv"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/btn_arrow_bottom"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/meal_more_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="더보기"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:fontFamily="@font/scdream_medium"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/meal_detail_container_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 조섬유 -->
                <LinearLayout
                    android:id="@+id/meal_fiber_section_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/meal_fiber_label_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="조섬유"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:fontFamily="@font/scdream_medium"/>

                        <TextView
                            android:id="@+id/meal_fiber_value_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="5%"
                            android:textColor="@color/gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/scdream_medium"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:id="@+id/meal_fiber_status_ll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/meal_fiber_status_iv"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:src="@drawable/ic_status_diamond"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/meal_fiber_status_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="양호"
                                android:textColor="@color/black"
                                android:textSize="10sp"
                                android:fontFamily="@font/scdream_light"/>
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/meal_fiber_bar_fl"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_meal_bar_outline">

                        <View
                            android:id="@+id/meal_fiber_fill_v"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_meal_fiber_fill" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/meal_extra_card_wrap_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/meal_ratio_card_cv"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#F2A16A"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/meal_ratio_label_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="칼슘 : 인"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:fontFamily="@font/scdream_medium"/>

                            <TextView
                                android:id="@+id/meal_ratio_value_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="1.2 : 1"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:fontFamily="@font/scdream_light"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/meal_taurine_card_cv"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="#F2A16A"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/meal_taurine_label_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="타우린"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:fontFamily="@font/scdream_medium"/>

                            <TextView
                                android:id="@+id/meal_taurine_value_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="25mg"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:fontFamily="@font/scdream_light"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/meal_extra_status_wrap_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/meal_ratio_status_ll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/meal_ratio_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/meal_ratio_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/meal_taurine_status_ll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:id="@+id/meal_taurine_status_iv"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_status_diamond"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/meal_taurine_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="양호"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:fontFamily="@font/scdream_light"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/meal_submit_btn"
                android:layout_width="280dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orange_fill_16"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:text="식단 최종 등록"
                android:textColor="@color/black"
                android:layout_marginTop="48dp"
                android:textSize="18sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>