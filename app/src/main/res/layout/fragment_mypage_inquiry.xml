<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/mypage_inquiry_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/mypage_inquiry_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="문의하기"
                android:textColor="@color/black"
                android:textSize="18sp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/mypage_inquiry_content_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/mypage_inquiry_title_et"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:fontFamily="@font/scdream_light"
            android:hint="제목을 입력하세요."
            android:inputType="text"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="#B5B5B5"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/mypage_inquiry_content_et"
            android:layout_width="match_parent"
            android:layout_height="366dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:fontFamily="@font/scdream_light"
            android:gravity="top|start"
            android:hint="내용을 입력하세요."
            android:inputType="textMultiLine"
            android:minLines="8"
            android:paddingStart="26dp"
            android:paddingTop="26dp"
            android:paddingEnd="26dp"
            android:paddingBottom="26dp"
            android:textColor="@color/black"
            android:textColorHint="#B5B5B5"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/mypage_inquiry_email_et"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:fontFamily="@font/scdream_light"
            android:hint="답변 받을 이메일을 입력하세요."
            android:inputType="textEmailAddress"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="#B5B5B5"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/mypage_inquiry_image_area"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/mypage_inquiry_image_iv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="이미지 첨부"
                android:src="@drawable/icon_image" />

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/mypage_inquiry_submit_btn"
        android:layout_width="284dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_filled_button"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:text="문의하기"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>