<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_radius_24"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- 상단 제목 + 닫기 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/water_dialog_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="오늘의 음수량"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/scdream_medium" />

        <ImageView
            android:id="@+id/water_dialog_close_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/icon_x"
            android:contentDescription="@null" />
    </RelativeLayout>

    <!-- 입력 영역 -->
    <LinearLayout
        android:id="@+id/water_input_container_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="vertical">

        <!-- 첫 번째 입력칸 -->
        <FrameLayout
            android:id="@+id/water_input_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/water_prefix_tv"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />

                <EditText
                    android:id="@+id/input_et"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_underline"
                    android:gravity="center"
                    android:hint="200"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium"
                    android:padding="0dp"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/water_unit_tv"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ml"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- 두 번째 입력칸 -->
        <FrameLayout
            android:id="@+id/water_input_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />

                <EditText
                    android:id="@+id/input_et_2"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_underline"
                    android:gravity="center"
                    android:hint="300"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium"
                    android:padding="0dp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ml"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- 세 번째 입력칸 -->
        <FrameLayout
            android:id="@+id/water_input_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />

                <EditText
                    android:id="@+id/input_et_3"
                    android:layout_width="80dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_underline"
                    android:gravity="center"
                    android:hint="100"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textColorHint="#888888"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium"
                    android:padding="0dp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ml"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:fontFamily="@font/scdream_medium" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- 추가하기 -->
    <LinearLayout
        android:id="@+id/meal_more_toggle_ll"
        android:layout_width="150dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_meal_more_toggle"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/meal_more_arrow_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/btn_arrow_bottom"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/meal_more_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="추가하기"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/scdream_medium" />
    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="160dp"
        android:layout_height="1dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="#6D6D6D" />

    <!-- 합계 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/water_total_prefix_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="="
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/scdream_medium" />

        <TextView
            android:id="@+id/water_total_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="600"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/scdream_regular" />

        <TextView
            android:id="@+id/water_total_unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="ml"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/scdream_medium" />
    </LinearLayout>

    <!-- 저장 버튼 -->
    <TextView
        android:id="@+id/water_save_btn"
        android:layout_width="280dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_orange_fill_16"
        android:fontFamily="@font/scdream_medium"
        android:gravity="center"
        android:text="저장하기"
        android:textColor="@color/black"
        android:textSize="18sp" />

</LinearLayout>