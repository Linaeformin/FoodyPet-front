<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_meal_item"
    android:layout_width="match_parent"
    android:layout_height="42dp">

    <TextView
        android:id="@+id/tv_food_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_regular"
        android:singleLine="true"
        android:text="닭오돌뼈"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_food_amount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/view_food_name_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginEnd="44dp"
        android:background="#FFB38A"
        app:layout_constraintEnd_toStartOf="@id/tv_food_amount"
        app:layout_constraintStart_toStartOf="@id/tv_food_name"
        app:layout_constraintTop_toBottomOf="@id/tv_food_name" />

    <TextView
        android:id="@+id/tv_food_amount"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:singleLine="true"
        android:text="10g"
        android:textColor="#333333"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_food_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_food_name" />

    <View
        android:id="@+id/view_food_amount_line"
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:background="#FFB38A"
        app:layout_constraintEnd_toEndOf="@id/tv_food_amount"
        app:layout_constraintStart_toStartOf="@id/tv_food_amount"
        app:layout_constraintTop_toBottomOf="@id/tv_food_amount" />

</androidx.constraintlayout.widget.ConstraintLayout>