<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stock_item_root"
    android:layout_width="match_parent"
    android:layout_height="35dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_item_stock"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/stock_expire_date_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:gravity="center"
        android:includeFontPadding="false"
        android:fontFamily="@font/scdream_light"
        android:text="~26.11.30"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/stock_name_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:fontFamily="@font/scdream_light"
        android:maxLines="1"
        android:text="흑돼지 치즈볼"
        android:textColor="@color/black"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/stock_count_tv"
        android:layout_width="75dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="1봉"
        android:fontFamily="@font/scdream_light"
        android:textColor="@color/black"
        android:textSize="13sp" />

</LinearLayout>