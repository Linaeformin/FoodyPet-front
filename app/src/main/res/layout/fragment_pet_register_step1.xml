<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/pet_register_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/pet_register_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="반려동물 등록"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:id="@+id/pet_register_indicator_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="46dp">

        <TextView
            android:id="@+id/pet_register_indicator_1_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/indicator_number_select"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_2_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="2"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_3_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="3"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_4_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="4"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/pet_register_step1_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="반려동물의 기본 정보를&#10;입력해주세요."
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_indicator_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="54dp" />

    <!-- 카메라 원형 영역 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/pet_register_camera_area"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_marginTop="34dp"
        app:cardCornerRadius="66dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintTop_toBottomOf="@id/pet_register_step1_description_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_camera">

            <!-- 선택한 이미지 -->
            <ImageView
                android:id="@+id/pet_register_selected_image_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 기본 카메라 아이콘 -->
            <ImageView
                android:id="@+id/pet_register_camera_iv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="카메라"
                android:src="@drawable/icon_camera" />

        </FrameLayout>

    </androidx.cardview.widget.CardView>

    <!-- 이름 입력 -->
    <EditText
        android:id="@+id/pet_register_name_et"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_orange_stroke_16"
        android:fontFamily="@font/scdream_regular"
        android:hint="이름"
        android:inputType="text"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/black"
        android:textColorHint="#B5B5B5"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_camera_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 생일 입력 -->
    <EditText
        android:id="@+id/pet_register_birth_et"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_orange_stroke_16"
        android:fontFamily="@font/scdream_regular"
        android:hint="생일 (ex. 2025.01.23)"
        android:inputType="date"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@color/black"
        android:textColorHint="#B5B5B5"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_name_et"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 다음으로 버튼 영역 -->
    <LinearLayout
        android:id="@+id/pet_register_next_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_birth_et"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="36dp">

        <TextView
            android:id="@+id/pet_register_next_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/scdream_regular"
            android:text="다음으로"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/pet_register_next_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="다음"
            android:src="@drawable/btn_arrow_right" />
    </LinearLayout>

    <!-- 수정완료 버튼 -->
    <TextView
        android:id="@+id/pet_register_edit_submit_btn"
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_bottom_filled_button"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:text="수정 완료"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pet_register_next_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>