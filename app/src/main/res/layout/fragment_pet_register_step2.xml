<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/pet_register_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/pet_register_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="반려동물 등록"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:id="@+id/pet_register_indicator_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="46dp"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_indicator_1_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="1"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_2_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_select"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="2"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_3_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="3"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_4_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="4"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/pet_register_step2_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="반려동물의 세부 정보를&#10;입력해주세요."
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_indicator_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 세부 정보 입력 박스 -->
    <LinearLayout
        android:id="@+id/pet_register_detail_box"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_orange_stroke_20"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_step2_description_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 종 -->
        <LinearLayout
            android:id="@+id/pet_register_species_row"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pet_register_species_label_tv"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/scdream_regular"
                android:text="종"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pet_register_dog_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_orange_fill_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="강아지"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_cat_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_orange_stroke_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="고양이"
                android:textColor="@color/regular_orange"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 품종 -->
        <LinearLayout
            android:id="@+id/pet_register_breed_row"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pet_register_breed_label_tv"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/scdream_regular"
                android:text="품종"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <AutoCompleteTextView
                android:id="@+id/pet_register_breed_dropdown_actv"
                android:layout_width="144dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_orange_stroke_8"
                android:popupBackground="@drawable/bg_dropdown_popup"
                android:dropDownVerticalOffset="4dp"
                android:drawableEnd="@drawable/btn_arrow_bottom_orange"
                android:drawablePadding="4dp"
                android:focusable="false"
                android:clickable="true"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:text="골든리트리버"
                android:textColor="@color/regular_orange"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 성별 -->
        <LinearLayout
            android:id="@+id/pet_register_gender_row"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pet_register_gender_label_tv"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/scdream_regular"
                android:text="성별"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pet_register_female_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_orange_fill_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="여"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_male_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_orange_stroke_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="남"
                android:textColor="@color/regular_orange"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 중성화 -->
        <LinearLayout
            android:id="@+id/pet_register_neutered_row"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pet_register_neutered_label_tv"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/scdream_regular"
                android:text="중성화"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pet_register_neutered_done_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_orange_fill_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="완료"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_neutered_not_done_tv"
                android:layout_width="68dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_orange_stroke_8"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:text="미완료"
                android:textColor="@color/regular_orange"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 다음으로 버튼 영역 -->
    <LinearLayout
        android:id="@+id/pet_register_next_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_detail_box"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_next_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/scdream_regular"
            android:text="다음으로"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/pet_register_next_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="다음"
            android:src="@drawable/btn_arrow_right" />
    </LinearLayout>

    <!-- 수정완료 버튼 -->
    <TextView
        android:id="@+id/pet_register_edit_submit_btn"
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_bottom_filled_button"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:text="수정 완료"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pet_register_next_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>