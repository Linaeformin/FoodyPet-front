<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_radius_24"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- 상단 헤더 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/snack_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/scdream_bold"
            android:text="오늘의 간식"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/snack_close_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="닫기"
            android:src="@drawable/icon_x" />
    </RelativeLayout>

    <!-- 이전 기록 -->
    <TextView
        android:id="@+id/snack_history_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/scdream_medium"
        android:text="이전 기록"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <!-- 기본 1개만 보이고, 스크롤하면 전체 열람 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/snack_history_rv"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="ifContentScrolls"/>

    <!-- 간식 등록 -->
    <TextView
        android:id="@+id/snack_register_label_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/scdream_medium"
        android:text="간식 등록"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <!-- 네가 준 RecyclerView 카드 구조 넣은 부분 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_meal_card_stroke"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/page_title_chip_tv"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_orange_fill_10"
                android:fontFamily="@font/scdream_medium"
                android:gravity="center"
                android:minWidth="78dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="4회"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/food_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="22dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/snack_save_btn"
        android:layout_width="280dp"
        android:layout_height="45dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_orange_fill_16"
        android:fontFamily="@font/scdream_light"
        android:gravity="center"
        android:text="저장하기"
        android:textColor="@color/black"
        android:textSize="18sp" />
</LinearLayout>