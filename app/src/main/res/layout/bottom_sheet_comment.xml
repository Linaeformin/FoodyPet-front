<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_bottom_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="620dp"
    android:background="@drawable/bg_bottom_sheet_white">

    <!-- 상단 헤더 -->
    <RelativeLayout
        android:id="@+id/comment_header_layout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/comment_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/scdream_bold"
            android:text="댓글"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- 헤더 하단 구분선 -->
    <View
        android:id="@+id/comment_header_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintTop_toBottomOf="@id/comment_header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 댓글 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/comment_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/comment_header_line"
        app:layout_constraintBottom_toTopOf="@id/comment_input_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 입력창 위 구분선 -->
    <View
        android:id="@+id/comment_input_line"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#EAEAEA"
        app:layout_constraintBottom_toTopOf="@id/comment_input_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 댓글 입력 영역 -->
    <LinearLayout
        android:id="@+id/comment_input_layout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/comment_my_profile_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="내 프로필 이미지"
            android:scaleType="centerCrop"
            android:src="@drawable/cat_2" />

        <EditText
            android:id="@+id/comment_input_et"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/scdream_regular"
            android:hint="댓글을 작성해보세요."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="40dp"
            android:padding="0dp"
            android:textColor="@color/black"
            android:textColorHint="#777777"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/comment_send_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:contentDescription="댓글 전송"
            android:src="@drawable/icon_send" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>