<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="36dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/light_orange"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- 왼쪽 이미지 + 시간 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_food"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_meal"
                android:background="@drawable/bg_orange_stroke_24"
                android:clipToOutline="true"
                android:contentDescription="식단 이미지" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="64dp"
                android:layout_height="28dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_home_meal_time"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="13:00"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="@font/scdream_medium" />
        </LinearLayout>

        <!-- 오른쪽 텍스트 정보 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 선호 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="선호"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/scdream_regular" />

                <LinearLayout
                    android:id="@+id/layout_preference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_preference1"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_like"
                        android:contentDescription="선호1" />

                    <ImageView
                        android:id="@+id/iv_preference2"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_like"
                        android:contentDescription="선호2" />

                    <ImageView
                        android:id="@+id/iv_preference3"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_like"
                        android:contentDescription="선호3" />

                    <ImageView
                        android:id="@+id/iv_preference4"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/icon_like"
                        android:contentDescription="선호4" />

                    <ImageView
                        android:id="@+id/iv_preference5"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/icon_unlike"
                        android:contentDescription="선호5" />
                </LinearLayout>
            </LinearLayout>

            <!-- 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="상태"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/scdream_regular" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="80dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="다 먹음"
                    android:textColor="@color/regular_orange"
                    android:textSize="12sp"
                    android:fontFamily="@font/scdream_regular"
                    android:background="@drawable/bg_orange_stroke_20" />
            </LinearLayout>

            <!-- 식단 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="식단"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/scdream_regular" />

                <TextView
                    android:id="@+id/tv_food_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="흑돼지 치즈볼 1개, 닭오돌뼈 10g, 플라그오프 등"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/scdream_light"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <!-- 메모 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="메모"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:fontFamily="@font/scdream_regular" />

                <TextView
                    android:id="@+id/tv_memo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="맛있게 먹기는 하는데 설사랑 구토를 하고 있음."
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/scdream_light"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="true"
                    android:paddingBottom="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>