<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/pet_register_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/pet_register_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="반려동물 등록"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:id="@+id/pet_register_indicator_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="46dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_indicator_1_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/indicator_number_unselect"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_2_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_3_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_4_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_select"
            android:fontFamily="@font/scdream_medium"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/pet_register_step4_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:fontFamily="@font/scdream_light"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="하루동안 급여하는 영양제를&#10;입력해주세요."
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_indicator_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 영양제 입력 박스 -->
    <LinearLayout
        android:id="@+id/pet_register_supplement_box"
        android:layout_width="330dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_orange_stroke_20"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="36dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_step4_description_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 영양제 1 -->
        <LinearLayout
            android:id="@+id/pet_register_supplement_1_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pet_register_supplement_name_1_et"
                android:layout_width="178dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:hint="영양제 이름을 입력해주세요."
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:text="오메가3"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_supplement_count_1_et"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:inputType="number"
                android:singleLine="true"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_supplement_count_1_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_light"
                android:text="회"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 영양제 2 -->
        <LinearLayout
            android:id="@+id/pet_register_supplement_2_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pet_register_supplement_name_2_et"
                android:layout_width="178dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:hint="영양제 이름을 입력해주세요."
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_supplement_count_2_et"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:hint="n"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_supplement_count_2_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_light"
                android:text="회"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 영양제 3 -->
        <LinearLayout
            android:id="@+id/pet_register_supplement_3_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pet_register_supplement_name_3_et"
                android:layout_width="178dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:hint="영양제 이름을 입력해주세요."
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_supplement_count_3_et"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:hint="n"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_supplement_count_3_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_light"
                android:text="회"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 영양제 4 -->
        <LinearLayout
            android:id="@+id/pet_register_supplement_4_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pet_register_supplement_name_4_et"
                android:layout_width="178dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:hint="영양제 이름을 입력해주세요."
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_supplement_count_4_et"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:hint="n"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_supplement_count_4_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_light"
                android:text="회"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 영양제 5 -->
        <LinearLayout
            android:id="@+id/pet_register_supplement_5_row"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pet_register_supplement_name_5_et"
                android:layout_width="178dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:hint="영양제 이름을 입력해주세요."
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_supplement_count_5_et"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:backgroundTint="@color/regular_orange"
                android:fontFamily="@font/scdream_light"
                android:gravity="center"
                android:hint="n"
                android:inputType="number"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pet_register_supplement_count_5_unit_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/scdream_light"
                android:text="회"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 등록하기 버튼 -->
    <TextView
        android:id="@+id/pet_register_submit_btn"
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_bottom_filled_button"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:text="등록하기"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_supplement_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>