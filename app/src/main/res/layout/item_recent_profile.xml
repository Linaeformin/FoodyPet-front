<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recent_profile_item_cl"
    android:layout_width="110dp"
    android:layout_height="140dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_gray_stroke_16">

    <ImageView
        android:id="@+id/recent_profile_item_close_iv"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/icon_x"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/recent_profile_item_pet_fl"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/circle_border"
        android:padding="0.1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recent_profile_item_close_iv">

        <ImageView
            android:id="@+id/recent_profile_item_pet_iv"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cat_1" />

    </FrameLayout>

    <TextView
        android:id="@+id/recent_profile_item_nickname_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/scdream_regular"
        android:text="냠냠이먹자"
        android:textColor="@color/black"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recent_profile_item_pet_fl" />

    <TextView
        android:id="@+id/recent_profile_item_category_tv"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_stock_category"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="고양이"
        android:textColor="@color/black"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/recent_profile_item_nickname_tv"
        app:layout_constraintStart_toStartOf="@id/recent_profile_item_nickname_tv"
        app:layout_constraintTop_toBottomOf="@id/recent_profile_item_nickname_tv" />

</androidx.constraintlayout.widget.ConstraintLayout>