<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 고정 영역 -->
    <LinearLayout
        android:id="@+id/top_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/pet_register_back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="뒤로가기"
                android:src="@drawable/btn_arrow_left" />

            <TextView
                android:id="@+id/pet_register_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/scdream_bold"
                android:text="반려동물 등록"
                android:textColor="@color/black"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 단계 인디케이터 -->
    <LinearLayout
        android:id="@+id/pet_register_indicator_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="46dp"
        app:layout_constraintTop_toBottomOf="@id/top_area"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_indicator_1_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="1"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_2_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="2"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_3_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_select"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/pet_register_indicator_4_tv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/indicator_number_unselect"
            android:gravity="center"
            android:fontFamily="@font/scdream_medium"
            android:text="4"
            android:textColor="@color/black"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/pet_register_step3_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/scdream_light"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="하루 급여 횟수와 급여 시각을&#10;설정해주세요."
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="54dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_indicator_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 급여 횟수 선택 박스 -->
    <LinearLayout
        android:id="@+id/pet_register_meal_count_box"
        android:layout_width="330dp"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_orange_stroke_20"
        android:gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_step3_description_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_meal_count_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:fontFamily="@font/scdream_regular"
            android:gravity="center_vertical"
            android:text="급여 횟수"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/pet_register_meal_count_buttons_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pet_register_meal_count_top_row"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pet_register_meal_count_1_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_orange_stroke_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="1회"
                    android:textColor="@color/regular_orange"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pet_register_meal_count_2_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_orange_stroke_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="2회"
                    android:textColor="@color/regular_orange"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pet_register_meal_count_3_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_orange_fill_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="3회"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pet_register_meal_count_bottom_row"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pet_register_meal_count_4_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_orange_stroke_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="4회"
                    android:textColor="@color/regular_orange"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pet_register_meal_count_5_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_orange_stroke_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="5회"
                    android:textColor="@color/regular_orange"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pet_register_meal_count_6_tv"
                    android:layout_width="65dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_orange_stroke_8"
                    android:fontFamily="@font/scdream_medium"
                    android:gravity="center"
                    android:text="6회"
                    android:textColor="@color/regular_orange"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 급여 시간 입력 리스트 -->
    <LinearLayout
        android:id="@+id/pet_register_meal_time_list_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/pet_register_meal_count_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_1_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/pet_register_meal_time_1_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="1회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_1_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 08:00)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_2_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/pet_register_meal_time_2_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="2회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_2_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 13:00)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_3_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp">

            <TextView
                android:id="@+id/pet_register_meal_time_3_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="3회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_3_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 17:30)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_4_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/pet_register_meal_time_4_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="4회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_4_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 17:30)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_5_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/pet_register_meal_time_5_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="5회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_5_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 17:30)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 6회 -->
        <LinearLayout
            android:id="@+id/pet_register_meal_time_6_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_orange_stroke_20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="36dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/pet_register_meal_time_6_label_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/scdream_regular"
                android:text="6회"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/pet_register_meal_time_6_et"
                android:layout_width="210dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/scdream_regular"
                android:gravity="end|center_vertical"
                android:hint="시각을 입력해주세요 (ex 17:30)"
                android:inputType="time"
                android:textColor="@color/black"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 다음으로 버튼 영역 -->
    <LinearLayout
        android:id="@+id/pet_register_next_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintTop_toBottomOf="@id/pet_register_meal_time_list_area"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/pet_register_next_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/scdream_regular"
            android:text="다음으로"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/pet_register_next_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="다음"
            android:src="@drawable/btn_arrow_right" />
    </LinearLayout>

    <!-- 수정완료 버튼 -->
    <TextView
        android:id="@+id/pet_register_edit_submit_btn"
        android:layout_width="260dp"
        android:layout_height="50dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/bg_bottom_filled_button"
        android:fontFamily="@font/scdream_regular"
        android:gravity="center"
        android:text="수정 완료"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pet_register_next_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>