<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.FoodyPet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 앱 기본 테마 -->
    </style>

    <style name="Theme.FoodyPet" parent="Base.Theme.FoodyPet" />

    <!-- MaterialDatePicker 전용 테마 -->
    <style name="ThemeOverlay.FoodyPet.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">

        <item name="colorPrimary">@color/regular_orange</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/regular_orange</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/regular_orange</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <item name="materialCalendarHeaderTitle">@style/FoodyPetCalendarHeaderTitle</item>
        <item name="materialCalendarHeaderSelection">@style/FoodyPetCalendarHeaderSelection</item>


    </style>

    <style name="FoodyPetCalendarHeaderTitle" parent="@style/Widget.Material3.MaterialCalendar.HeaderTitle">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="FoodyPetCalendarHeaderSelection" parent="@style/Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="FoodyPetCalendarSelectedDay" parent="@style/Widget.Material3.MaterialCalendar.Day.Selected">
        <item name="itemFillColor">@color/regular_orange</item>
        <item name="itemTextColor">@color/white</item>
    </style>

    <style name="FoodyPetCalendarToday" parent="@style/Widget.Material3.MaterialCalendar.Day.Today">
        <item name="itemStrokeColor">@color/regular_orange</item>
        <item name="itemTextColor">@color/regular_orange</item>
    </style>

</resources>